# Web3Forms access key: required for the contact form to deliver email.
# Get a free key at https://web3forms.com with the portfolio email (samthedev@riseup.net).
# The form sends from the visitor's browser (the free plan refuses server requests), so this
# key ends up in the page's JavaScript. That is how Web3Forms is meant to be used: the key can
# only send mail to its own inbox. Without it the form shows "It didn't send".
WEB3FORMS_ACCESS_KEY=

# Optional: search-console ownership codes (the content="…" value of the meta tag each one gives you).
# Google Search Console: URL-prefix property → HTML tag method.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: HTML meta tag method (msvalidate.01).
BING_SITE_VERIFICATION=
